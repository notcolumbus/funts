{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "funts",
  "main": "vinext/server/fetch-handler",
  "compatibility_date": "2026-11-07",
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "directory": "./dist/client", "binding": "ASSETS" },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "funts",
